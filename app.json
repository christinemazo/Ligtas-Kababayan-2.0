{
  "expo": {
    "name": "Ligtas Kababayan",
    "slug": "ligtas-kababayan",
    "version": "0.2.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "plugins": [
      [
        "expo-location",
        { "locationWhenInUsePermission": "Ligtas Kababayan uses your location to tell rescuers where you are." }
      ]
    ],
    "android": {
      "package": "com.ligtas.kababayan",
      "permissions": ["ACCESS_FINE_LOCATION", "ACCESS_COARSE_LOCATION"]
    },
    "ios": {
      "bundleIdentifier": "com.ligtas.kababayan",
      "supportsTablet": false
    }
  }
}
